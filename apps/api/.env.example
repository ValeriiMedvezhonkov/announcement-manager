# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP API listens on
PORT=3000

# Origin allowed to call the API from the browser (the Vite dev server)
WEB_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Matches the credentials and host port defined in docker-compose.yml.
DATABASE_URL=postgresql://announcements:announcements@localhost:5433/announcements?schema=public
